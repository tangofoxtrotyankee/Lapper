# Lapper backend. Copy to .env and fill in what you need. Never commit real values.
# The server boots and stays healthy without any of these; AI endpoints return
# MODEL_UNAVAILABLE until OPENAI_API_KEY is set.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# AI (Phase 3). Only the API key is secret.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CHEAP=gpt-5.6-luna
OPENAI_MODEL_DEFAULT=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol
