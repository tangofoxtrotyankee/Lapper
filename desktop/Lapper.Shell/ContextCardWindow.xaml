<Window
    x:Class="Lapper.Shell.ContextCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lapper">
    <Border
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        KeyDown="OnRootKeyDown">
        <Grid Margin="16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="Lapper"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    VerticalAlignment="Center" />
                <CheckBox
                    x:Name="DeepToggle"
                    Grid.Column="1"
                    Content="Deep"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Use the deep model for complex content" />
                <Button x:Name="RefreshButton" Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Click="OnRefreshClicked" ToolTipService.ToolTip="Re-read this screen" />
                <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="OnHideClicked" ToolTipService.ToolTip="Hide (Esc)" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <StackPanel x:Name="StatusRow" Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="Spinner" IsActive="False" Width="20" Height="20" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="OrientationText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        FontSize="16"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="SummaryText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Visibility="Collapsed"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel x:Name="FactsPanel" Spacing="4" Visibility="Collapsed" />

                    <TextBlock
                        x:Name="WarningsText"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                    <StackPanel x:Name="ResultPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="Result" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ResultText"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CopyResultButton" Content="Copy" Click="OnCopyResultClicked" IsEnabled="False" />
                            <Button x:Name="ReadResultButton" Content="Read aloud" Click="OnReadResultClicked" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                x:Name="ActionsPanel"
                Grid.Row="2"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed" />

            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="QuestionBox"
                    PlaceholderText="Ask about this screen…"
                    KeyDown="OnQuestionKeyDown" />
                <Button
                    x:Name="AskButton"
                    Grid.Column="1"
                    Content="Ask"
                    Click="OnAskClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
