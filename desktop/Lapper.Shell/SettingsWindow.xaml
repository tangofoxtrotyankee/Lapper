<Window
    x:Class="Lapper.Shell.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lapper settings">
    <StackPanel Margin="24" Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Global shortcut" FontWeight="SemiBold" />
            <TextBlock
                Text="Combine Ctrl, Alt, Shift or Win with a letter, digit, F-key or Space. Example: Ctrl+Alt+L"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="ShortcutBox" PlaceholderText="Ctrl+Alt+L" />
            <TextBlock
                x:Name="ShortcutFeedback"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Backend URL" FontWeight="SemiBold" />
            <TextBlock
                Text="Where your Lapper backend runs. http is only allowed for this computer (localhost); anything remote must be https."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="BackendUrlBox" PlaceholderText="http://127.0.0.1:3000" />
            <TextBlock
                x:Name="BackendUrlFeedback"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Never look at these apps" FontWeight="SemiBold" />
            <TextBlock
                Text="Comma-separated program names, e.g. mybank.exe, privatediary.exe. Password managers and Windows security prompts are always excluded."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="ExcludedAppsBox" PlaceholderText="app1.exe, app2.exe" />
        </StackPanel>

        <ToggleSwitch x:Name="PillToggle" Header="Show the floating pill" />

        <ToggleSwitch
            x:Name="StartupToggle"
            Header="Start Lapper with Windows"
            Toggled="OnStartupToggled" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClicked" />
            <TextBlock
                x:Name="SaveFeedback"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</Window>
