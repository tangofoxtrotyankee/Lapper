<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cross-platform on purpose: pure HttpClient/SSE logic with no
         Windows dependency, so its tests run on Linux and Windows alike. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lapper.ApiClient</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <Description>REST/SSE client for the Lapper backend: retry/cancellation, typed stream events, error mapping. Holds no provider secrets.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lapper.Contracts\Lapper.Contracts.csproj" />
  </ItemGroup>

</Project>
